[cells]
  root = .
  prelude = prelude
  toolchains = toolchains
  build = build
  none = none
[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none
[external_cells]
  prelude = bundled
  build = git
[external_cell_build]
  git_origin = https://github.com/tomWhiting/build.git
  commit_hash = 4fd0427f7af1901f4be1b28a18001ee646cd9143
[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default target:prelude//...->prelude//platforms:default target:toolchains//...->prelude//platforms:default target:build//...->prelude//platforms:default
[build]
  execution_platforms = build//buck:local-platforms
[project]
  ignore = .git, .worktrees, target, node_modules, .gate, third-party/.cargo, third-party/target
[buck2]
  defer_write_actions = true
  sqlite_materializer_state = true
