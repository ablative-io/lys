#!/usr/bin/env bash
# A checkout's entry for builds and tests (generated by build//buck/buckgen).
# It sets this machine up at the checkout's build pin whenever it isn't, a
# fresh checkout or a pull that moved the pin, then runs that pin's buckbuild.
# Tools come from ~/.local/bin, /usr/bin or /bin, where Mayflower places them,
# never from the caller's PATH.
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
pin=$(sed -n 's/^[[:space:]]*commit_hash[[:space:]]*=[[:space:]]*\([0-9a-f]\{40\}\)[[:space:]]*$/\1/p' "$root/.buckconfig")
if [ -z "$pin" ]; then
  echo "toolchains/buckbuild: $root/.buckconfig pins no build commit" >&2
  exit 1
fi
tool() {
  for dir in "$HOME/.local/bin" /usr/bin /bin; do
    if [ -x "$dir/$1" ] && [ ! -d "$dir/$1" ]; then
      echo "$dir/$1"
      return 0
    fi
  done
  echo "toolchains/buckbuild: $1 is in none of $HOME/.local/bin, /usr/bin, /bin, so this machine can't be set up at build $pin; Mayflower places it" >&2
  return 1
}
if [ "$(cat "$root/toolchains/_local/pin" 2>/dev/null)" != "$pin" ] || [ ! -x "$root/toolchains/_local/buckbuild" ]; then
  echo "toolchains/buckbuild: setting this machine up at build $pin" >&2
  cell="$root/buck-out/v2/external_cells/git/$pin"
  if [ ! -f "$cell/go.mod" ]; then
    buck=$(tool buck2)
    (cd "$root" && "$buck" uquery build//buck:rules.bzl > /dev/null)
  fi
  go=$(tool go)
  "$go" run -C "$cell" ./buck/bucksetup --root "$root"
fi
exec "$root/toolchains/_local/buckbuild" "$@"
