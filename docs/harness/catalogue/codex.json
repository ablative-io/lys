{
  "name": "Codex",
  "command": "codex",
  "commands": ["codex", "cdx"],
  "line": "An agent from OpenAI that helps read, change and test code.",
  "models": [
    {
      "id": "gpt-6.1-sol",
      "label": "GPT-6.1 Sol"
    },
    {
      "id": "gpt-6-astra",
      "label": "GPT-6 Astra"
    },
    {
      "id": "gpt-6-luna",
      "label": "GPT-6 Luna"
    },
    {
      "id": "gpt-6-sol",
      "label": "GPT-6 Sol"
    }
  ],
  "modes": [
    {
      "id": "read-only",
      "meaning": "Commands cannot change any file or use the network while they stay in Codex's sandbox. They can read every file this login can read. Lys does not turn web search off in this mode."
    },
    {
      "id": "workspace-write",
      "meaning": "Commands change files only in the working folder and extra folders, with no network, and web search is off. They can read every file this login can read."
    },
    {
      "id": "danger-full-access",
      "meaning": "No sandbox. Commands change files anywhere this login can and use the network."
    }
  ],
  "description": {
    "models": {
      "minimum": 1,
      "maximum": 1,
      "further_encoding": {
        "kind": "array"
      }
    },
    "permissions": {
      "modes": [
        "read-only",
        "workspace-write",
        "danger-full-access"
      ],
      "rule_forms": []
    },
    "mcp": {
      "transports": [
        "http",
        "stdio"
      ],
      "working_directory": true,
      "handle_variables": true,
      "channel_policies": [
        "off"
      ]
    },
    "rendering_contract": "codex/template-v1"
  },
  "sources": [
    "https://learn.chatgpt.com/docs/models",
    "https://learn.chatgpt.com/docs/config-file/config-reference",
    "https://learn.chatgpt.com/docs/agent-approvals-security"
  ]
}
