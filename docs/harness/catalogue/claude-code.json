{
  "name": "Claude Code",
  "command": "claude",
  "commands": ["claude"],
  "line": "An agent from Anthropic that helps read, change and test code.",
  "models": [
    {
      "id": "default",
      "label": "Default for this account"
    },
    {
      "id": "fable",
      "label": "Fable"
    },
    {
      "id": "sonnet",
      "label": "Sonnet"
    },
    {
      "id": "opus",
      "label": "Opus"
    },
    {
      "id": "haiku",
      "label": "Haiku"
    }
  ],
  "modes": [
    {
      "id": "default",
      "meaning": "Reads freely and asks before most changes and commands."
    },
    {
      "id": "acceptEdits",
      "meaning": "Reads and edits files without asking; other commands can require approval."
    },
    {
      "id": "plan",
      "meaning": "Explores and plans before making changes; eligible commands can receive automatic review."
    },
    {
      "id": "auto",
      "meaning": "Reviews actions automatically before allowing them."
    },
    {
      "id": "dontAsk",
      "meaning": "Uses only reads and approved tools; refuses actions that would require a prompt."
    },
    {
      "id": "bypassPermissions",
      "meaning": "Skips permission prompts; explicit denial rules still apply."
    },
    {
      "id": "workspace-only",
      "meaning": "Works in its own folder with shell sandboxing and internet tools off. Shell commands can also write to the program's temporary folder."
    }
  ],
  "description": {
    "models": {
      "minimum": 1,
      "maximum": null,
      "further_encoding": {
        "kind": "delimited",
        "separator": ","
      }
    },
    "permissions": {
      "modes": [
        "default",
        "acceptEdits",
        "plan",
        "auto",
        "dontAsk",
        "bypassPermissions",
        "workspace-only"
      ],
      "rule_forms": [
        "tool_specifier"
      ]
    },
    "mcp": {
      "transports": [
        "http",
        "stdio"
      ],
      "working_directory": false,
      "handle_variables": true,
      "channel_policies": [
        "off",
        "wake"
      ]
    },
    "rendering_contract": "claude-code/template-v1"
  },
  "sources": [
    "https://code.claude.com/docs/en/model-config",
    "https://code.claude.com/docs/en/permission-modes"
  ]
}
